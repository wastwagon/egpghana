# Environment Variables for EGP Ghana Website
# Copy to .env for local use. Never commit .env — Coolify sets production secrets separately.

# =============================================================================
# LOCAL DEVELOPMENT (Docker Desktop + npm run dev)
# =============================================================================

# Database — docker-compose.dev.yml maps host 5433 → container 5432
DATABASE_URL="postgresql://egp_user:egp_dev_password_2026@localhost:5433/egp_db"
DB_PASSWORD="egp_dev_password_2026"

REDIS_URL="redis://localhost:6379"

# App runs on port 3456 locally
NEXT_PUBLIC_APP_URL="http://localhost:3456"
NEXTAUTH_URL="http://localhost:3456"
NODE_ENV="development"

# Required for local `npx prisma db seed` / `npm run db:restore`
ADMIN_EMAIL="admin@egpghana.org"
ADMIN_PASSWORD="admin123"

PGADMIN_EMAIL="admin@egpghana.org"
PGADMIN_PASSWORD="admin123"

NEXTAUTH_SECRET="change-this-for-local-only"

OPENAI_API_KEY="your_openai_api_key_here"

WORLD_BANK_API_URL="https://api.worldbank.org/v2"
IMF_API_URL="https://data.imf.org/api"
GHANA_API_URL="https://api.ghana-api.dev/v1"

MAX_FILE_SIZE="10485760"
UPLOAD_DIR="./public/uploads"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@egpghana.org"
CAREERS_NOTIFY_EMAIL="egpghana20@gmail.com"

NEXT_PUBLIC_GA_ID=""
CRON_SECRET=""

# Leave these unset/false locally and on Coolify for normal deploys
RUN_SYNC_ON_STARTUP=""
RUN_SEED_ON_STARTUP=""
ALLOW_DESTRUCTIVE_SEED=""

# =============================================================================
# COOLIFY / PRODUCTION — set these in the Coolify UI, not in this file
# =============================================================================
# Build pack: Dockerfile (never Docker Compose)
# DATABASE_URL / REDIS_URL: internal Coolify connection strings
# NEXTAUTH_URL / NEXT_PUBLIC_APP_URL: https://egpghana.org
# NODE_ENV=production
# NEXTAUTH_SECRET: long random string (not the local placeholder)
# UPLOADS_DIR=/data/uploads  + persistent volume destination /data/uploads
# CRON_SECRET: long random hex
# RUN_SYNC_ON_STARTUP=true
# Do NOT set RUN_SEED_ON_STARTUP or ALLOW_DESTRUCTIVE_SEED except on a brand-new empty database
# CAREERS_NOTIFY_EMAIL=egpghana20@gmail.com
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM for EOI email notifications
